 <HierarchicalDataTemplate DataType="{x:Type local:NodeVM}" ItemsSource="{Binding Children}">
  <Grid ToolTip="{Binding Tip}" HorizontalAlignment="Stretch">
   <TextBlock x:Name="NetworkTitle" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
   <Grid x:Name="PeerRow" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
    <Canvas Width="19" Height="14" VerticalAlignment="Center" AutomationProperties.AutomationId="PeerSignal"><Path Data="M 1,7 L 5,11 M 5,7 L 1,11" Stroke="{DynamicResource Neutral}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding Online,Converter={StaticResource InverseVisibility}}" AutomationProperties.AutomationId="OfflineCross"/><Rectangle Canvas.Left="3" Canvas.Top="10" Width="2" Height="3" Fill="{Binding Signal,Converter={StaticResource SignalColor},ConverterParameter=1}" AutomationProperties.AutomationId="SignalBar1" Visibility="{Binding Online,Converter={StaticResource BoolVisibility}}"/><Rectangle Canvas.Left="7" Canvas.Top="7" Width="2" Height="6" Fill="{Binding Signal,Converter={StaticResource SignalColor},ConverterParameter=2}" AutomationProperties.AutomationId="SignalBar2"/><Rectangle Canvas.Left="11" Canvas.Top="4" Width="2" Height="9" Fill="{Binding Signal,Converter={StaticResource SignalColor},ConverterParameter=3}" AutomationProperties.AutomationId="SignalBar3"/><Rectangle Canvas.Left="15" Canvas.Top="1" Width="2" Height="12" Fill="{Binding Signal,Converter={StaticResource SignalColor},ConverterParameter=4}" AutomationProperties.AutomationId="SignalBar4"/></Canvas><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="4,0,6,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="2" Text="{Binding Ip}" FontSize="12" HorizontalAlignment="Left" AutomationProperties.AutomationId="PeerIp"/>
   </Grid>
  <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="22"/><Style.Triggers><DataTrigger Binding="{Binding IsNetwork}" Value="True"><Setter Property="MinHeight" Value="24"/></DataTrigger></Style.Triggers></Style></Grid.Style></Grid>
  <HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsNetwork}" Value="False"><Setter TargetName="NetworkTitle" Property="Visibility" Value="Collapsed"/><Setter TargetName="PeerRow" Property="Visibility" Value="Visible"/></DataTrigger></HierarchicalDataTemplate.Triggers>
 </HierarchicalDataTemplate>
