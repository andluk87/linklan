<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LinkLAN</AssemblyName><RootNamespace>LinkLAN.Desktop</RootNamespace>
    <Product>LinkLAN</Product><Description>LinkLAN Windows VPN client</Description>
    <ApplicationIcon>../../assets/linklan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <PublishTrimmed>false</PublishTrimmed><PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="*.xaml"/><EmbeddedResource Include="Strings.json"/>
    <EmbeddedResource Include="../../assets/linklan-icon.png" Link="logo.png"/>
  </ItemGroup>
</Project>
