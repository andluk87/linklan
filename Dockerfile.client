# syntax=docker/dockerfile:1
# Cross-publish WPF with its Windows runtime; compile the VPN engine without CGO.
FROM golang:1.26.8-bookworm AS go
FROM mcr.microsoft.com/dotnet/sdk:10.0.404 AS build
COPY --from=go /usr/local/go /usr/local/go
ENV PATH="/usr/local/go:${PATH}" GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOTELEMETRY=off DOTNET_CLI_TELEMETRY_OPTOUT=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates nsis python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
# WPF updates use the full installer/ZIP; never sign a two-file legacy updater payload.
RUN python3 scripts/build-client.py --installer --output /out
FROM scratch AS artifacts
COPY --from=build /out/ /
